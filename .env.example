# Copy this file to .env and fill in real values. Never commit .env itself.

# Required. Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. If set, the app requires this passcode (sent as the X-Access-Code
# header) before answering any question. Leave blank to allow anyone with the
# URL to use the app.
ACCESS_CODE=

# Optional. Defaults to gemini-flash-latest if not set.
GEMINI_MODEL=
